{
  "name": "dsh-live-model-probe",
  "version": "0.1.0",
  "description": "DSH 模型探测：用已存凭据询问模型厂商的实时目录，比较后经官方配置编辑器安全写回。",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "keywords": ["dsh-plugin", "deepseek-harness", "models", "model-discovery", "live-models"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lyufeng000/dsh-model-probe.git" },
  "homepage": "https://github.com/lyufeng000/dsh-model-probe#readme",
  "bugs": { "url": "https://github.com/lyufeng000/dsh-model-probe/issues" },
  "author": "lyufeng000",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.4" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-modules", "@deepseek-ai/dsh-client-ui-settings"] }
  }
}
